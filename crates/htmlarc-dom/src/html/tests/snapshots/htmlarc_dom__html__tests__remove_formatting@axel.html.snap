umb/8/80/Wikipedia-logo-v2.svg/40px-Wikipedia-logo-v2.svg.png" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/8/80/Wikipedia-logo-v2.svg/60px-Wikipedia-logo-v2.svg.png 1.5x, //upload.wikimedia.org/wikipedia/commons/thumb/8/80/Wikipedia-logo-v2.svg/80px-Wikipedia-logo-v2.svg.png 2x" width="40" /></a></div></div><div style="margin-left: 60px;"><a class="extiw" href="https://sv.wikipedia.org/wiki/Main_Page" title="w:Main Page">Wikipedia</a> har en artikel om:<br /> <span style="font-size:1.1em"><i><b><a class="extiw" href="https://sv.wikipedia.org/wiki/Axel_(konst%C3%A5kning)" title="w:Axel (konståkning)">Axel (konståkning)</a></b></i></span></div></div></section><h2 class="section-heading" onclick="javascript:mfTempOpenSection(1)"><div class="mw-ui-icon mw-ui-icon-element indicator mw-ui-icon-small mw-ui-icon-flush-left"></div><span class="mw-headline" id="Svenska">Svenska</span><span class="mw-editsection"><a class="mw-ui-icon mw-ui-icon-element mw-ui-icon-wikimedia-edit-base20 edit-page mw-ui-icon-flush-right" data-section="1" href="/w/index.php?title=axel&amp;action=edit&amp;section=1" title="Redigera avsnitt Svenska">Redigera</a></span></h2><section class="mf-section-1 collapsible-block" id="mf-section-1"><h3 class="in-block"><span class="mw-headline" id="Substantiv">Substantiv</span><span class="mw-editsection"><a class="mw-ui-icon mw-ui-icon-element mw-ui-icon-wikimedia-edit-base20 edit-page mw-ui-icon-flush-right" data-section="2" href="/w/index.php?title=axel&amp;action=edit&amp;section=2" title="Redigera avsnitt Substantiv">Redigera</a></span></h3><table class="grammar template-sv-subst-n-ar" cellspacing="0" width="10"><tbody><tr><th class="main">Böjningar&nbsp;av <i><a class="mw-selflink selflink">axel</a>&nbsp;</i></th><th class="min" colspan="2">Singular</th><th class="min" colspan="2">Plural</th></tr><tr><th class="main">utrum</th><th>Obestämd</th><th>Bestämd</th><th>Obestämd</th><th>Bestämd</th></tr><tr><th>Nominativ</th><td><span class="infl"><a class="mw-selflink selflink">axel</a></span></td><td><span class="infl"><a href="/wiki/axeln#Svenska" title="axeln">axeln</a></span></td><td><span class="infl"><a href="/wiki/axlar#Svenska" title="axlar">axlar</a></span></td><td><span class="infl"><a href="/wiki/axlarna#Svenska" title="axlarna">axlarna</a></span></td></tr><tr><th>Genitiv</th><td><span class="infl"><a href="/wiki/axels#Svenska" title="axels">axels</a></span></td><td><span class="infl"><a href="/wiki/axelns#Svenska" title="axelns">axelns</a></span></td><td><span class="infl"><a href="/wiki/axlars#Svenska" title="axlars">axlars</a></span></td><td><span class="infl"><a href="/wiki/axlarnas#Svenska" title="axlarnas">axlarnas</a></span></td></tr></tbody></table><div class="thumb tright"><div class="thumbinner" style="width:172px;"><a class="image" href="/wiki/Fil:Gray326.png"><noscript><img class="thumbimage" data-file-width="452" data-file-height="500" alt src="//upload.wikimedia.org/wikipedia/commons/thumb/3/3b/Gray326.png/170px-Gray326.png" decoding="async" width="170" height="188" /></noscript><span class="lazy-image-placeholder" data-alt="" data-class="thumbimage" data-height="188" data-src="//upload.wikimedia.org/wikipedia/commons/thumb/3/3b/Gray326.png/170px-Gray326.png" data-width="170" style="width: 170px;height: 188px;">&nbsp;</span></a>  <div class="thumbcaption"><div class="magnify"><a class="internal" href="/wiki/Fil:Gray326.png" title="Förstora"></a></div> vänster <b>axel</b> (kroppsdel) framifrån</div></div></div><div class="thumb tright"><div class="thumbinner" style="width:172px;"><a class="image" href="/wiki/Fil:Rollingstock_axle.jpg"><noscript><img class="thumbimage" data-file-width="800" data-file-height="600" alt src="//upload.wikimedia.org/wikipedia/commons/thumb/7/76/Rollingstock_axle.jpg/170px-Rollingstock_axle.jpg" decoding="async" width="170" height="128" /></noscript><span class="lazy-image-placeholder" data-alt="" data-class="thumbimage" data-height="128" data-src="//upload.wikimedia.org/wikipedia/commons/thumb/7/76/Rollingstock_axle.jpg/170px-Rollingstock_axle.jpg" data-width="170" style="width: 170px;height: 128px;">&nbsp;</span></a>  <div class="thumbcaption"><div class="magnify"><a class="internal" href="/wiki/Fil:Rollingstock_axle.jpg" title="Förstora"></a></div> järnvägshjulpar med axel (<b>hjulaxel</b>)</div></div></div><div class="thumb tright"><div class="thumbinner" style="width:172px;"><a class="image" href="/wiki/Fil:Cardan-joint_intermediate-shaft_topview_animated.gif"><noscript><img class="thumbimage" data-file-width="451" data-file-height="208" alt src="//upload.wikimedia.org/wikipedia/commons/thumb/c/cd/Cardan-joint_intermediate-shaft_topview_animated.gif/170px-Cardan-joint_intermediate-shaft_topview_animated.gif" decoding="async" width="170" height="78" /></noscript><span class="lazy-image-placeholder" data-alt="" data-class="thumbimage" data-height="78" data-src="//upload.wikimedia.org/wikipedia/commons/thumb/c/cd/Cardan-joint_intermediate-shaft_topview_animated.gif/170px-Cardan-joint_intermediate-shaft_topview_animated.gif" data-width="170" style="width: 170px;height: 78px;">&nbsp;</span></a>  <div class="thumbcaption"><div class="magnify"><a class="internal" href="/wiki/Fil:Cardan-joint_intermediate-shaft_topview_animated.gif" title="Förstora"></a></div> kardanaxel (<b>drivaxel</b>)</div></div></div><p><b>axel</b></p><ul><li><b><a href="/wiki/Wiktionary:Stilguide/Uttal" title="Wiktionary:Stilguide/Uttal">uttal</a>:</b>&nbsp;/<span class="ipa">ˈak.sɛl</span>/</li></ul><ol><li><i>(anatomi)</i>  en kroppsdel; ovan- och yttersidan av <a href="/wiki/arm" title="arm">armens</a> fäste i <a href="/wiki/torso" title="torso">torson</a><dl><dd><i>Jag har så ont i <b>axeln</b>.</i></dd><dd></dd><dd class="semantic-relation template-synonymer"><em title="Ord med samma betydelse">Synonymer:</em> <a href="/wiki/%C3%A4rd%C3%A4" title="ärdä">ärdä</a> <i>(orsamål)</i>, <a href="/wiki/skuldra" title="skuldra">skuldra</a></dd><dd></dd><dd class="semantic-relation template-besläktade_ord"><em title="Relaterade ord med samma ursprung (men som har andra prefix eller suffix, eller är av annan ordklass)">Besläktade ord:</em> <a href="/wiki/axla" title="axla">axla</a></dd><dd></dd><dd class="semantic-relation template-sammansättningar"><em title="Ord som består av flera andra ord">Sammansättningar:</em> <a class="new" href="/w/index.php?title=axelband&amp;action=edit&amp;redlink=1" title="axelband (inte skapad ännu)">axelband</a>, <a class="new" href="/w/index.php?title=axelbred&amp;action=edit&amp;redlink=1" title="axelbred (inte skapad ännu)">axelbred</a>, <a class="new" href="/w/index.php?title=axelbredd&amp;action=edit&amp;redlink=1" title="axelbredd (inte skapad ännu)">axelbredd</a>, <a class="new" href="/w/index.php?title=axelh%C3%A5la&amp;action=edit&amp;redlink=1" title="axelhåla (inte skapad ännu)">axelhåla</a>, <a href="/wiki/axelklaff" title="axelklaff">axelklaff</a>, <a class="new" href="/w/index.php?title=axelrem&amp;action=edit&amp;redlink=1" title="axelrem (inte skapad ännu)">axelrem</a>, <a href="/wiki/axelryckning" title="axelryckning">axelryckning</a>, <a class="new" href="/w/index.php?title=axelsjal&amp;action=edit&amp;redlink=1" title="axelsjal (inte skapad ännu)">axelsjal</a>, <a class="new" href="/w/index.php?title=axelschal&amp;action=edit&amp;redlink=1" title="axelschal (inte skapad ännu)">axelschal</a>, <a class="new" href="/w/index.php?title=axelvadd&amp;action=edit&amp;redlink=1" title="axelvadd (inte skapad ännu)">axelvadd</a>, <a href="/wiki/axelv%C3%A4ska" title="axelväska">axelväska</a></dd><dd></dd><dd class="semantic-relation template-fraser"><em title="Begrepp som består av flera ord">Fraser:</em> <a href="/wiki/se_%C3%B6ver_axeln" title="se över axeln">se över axeln</a></dd></dl></li><li><i>(mekanik)</i>  hjulaxel; stångliknande maskindel som <a href="/wiki/hjul" title="hjul">hjul</a> (eller något annat) <a href="/wiki/rotera" title="rotera">roterar</a> runt<dl><dd></dd><dd class="semantic-relation template-jämför"><em title="Andra liknande begrepp">Jämför:</em> <a href="/wiki/pivot" title="pivot">pivot</a>, <a class="new" href="/w/index.php?title=piv%C3%A5&amp;action=edit&amp;redlink=1" title="pivå (inte skapad ännu)">pivå</a>, <a class="new" href="/w/index.php?title=vridningsaxel&amp;action=edit&amp;redlink=1" title="vridningsaxel (inte skapad ännu)">vridningsaxel</a>, <a class="new" href="/w/index.php?title=axeltapp&amp;action=edit&amp;redlink=1" title="axeltapp (inte skapad ännu)">axeltapp</a>, <a class="new" href="/w/index.php?title=sv%C3%A4ngtapp&amp;action=edit&amp;redlink=1" title="svängtapp (inte skapad ännu)">svängtapp</a></dd><dd></dd><dd class="semantic-relation template-sammansättningar"><em title="Ord som består av flera andra ord">Sammansättningar:</em> <a class="new" href="/w/index.php?title=axelbrott&amp;action=edit&amp;redlink=1" title="axelbrott (inte skapad ännu)">axelbrott</a>, <a class="new" href="/w/index.php?title=hjulaxel&amp;action=edit&amp;redlink=1" title="hjulaxel (inte skapad ännu)">hjulaxel</a>, <a class="new" href="/w/index.php?title=pendelaxel&amp;action=edit&amp;redlink=1" title="pendelaxel (inte skapad ännu)">pendelaxel</a>, <a class="new" href="/w/index.php?title=bakaxel&amp;action=edit&amp;redlink=1" title="bakaxel (inte skapad ännu)">bakaxel</a>, <a class="new" href="/w/index.php?title=vridningsaxel&amp;action=edit&amp;redlink=1" title="vridningsaxel (inte skapad ännu)">vridningsaxel</a>, <a class="new" href="/w/index.php?title=axeltapp&amp;action=edit&amp;redlink=1" title="axeltapp (inte skapad ännu)">axeltapp</a></dd></dl></li><li><i>(mekanik, kort för)</i>  drivaxel; långsträckt, <a href="/wiki/rotera" title="rotera">roterande</a> maskindel för överföring av mekanisk effekt (i form av <a class="new" href="/w/index.php?title=rotationsfrekvens&amp;action=edit&amp;redlink=1" title="rotationsfrekvens (inte skapad ännu)">rotationsfrekvens</a> och <a href="/wiki/vridmoment" title="vridmoment">vridmoment</a>)<dl><dd></dd><dd class="semantic-relation template-sammansättningar"><em title="Ord som består av flera andra ord">Sammansättningar:</em> <a class="new" href="/w/index.php?title=drivaxel&amp;action=edit&amp;redlink=1" title="drivaxel (inte skapad ännu)">drivaxel</a>, <a href="/wiki/kardanaxel" title="kardanaxel">kardanaxel</a>, <a class="new" href="/w/index.php?title=axelkoppling&amp;action=edit&amp;redlink=1" title="axelkoppling (inte skapad ännu)">axelkoppling</a></dd></dl></li><li><i>(abstrakt)</i>  tänkt <a href="/wiki/mittlinje" title="mittlinje">mittlinje</a> kring vilken något <a href="/wiki/rotera" title="rotera">roterar</a> eller (<a href="/wiki/symmetrisk" title="symmetrisk">symmetriskt</a>) grupperar sig<dl><dd></dd><dd class="semantic-relation template-sammansättningar"><em title="Ord som består av flera andra ord">Sammansättningar:</em> <a class="new" href="/w/index.php?title=blomaxel&amp;action=edit&amp;redlink=1" title="blomaxel (inte skapad ännu)">blomaxel</a>, <a href="/wiki/jordaxel" title="jordaxel">jordaxel</a>, <a href="/wiki/symmetriaxel" title="symmetriaxel">symmetriaxel</a></dd></dl></li><li><i>(matematik, kort för)</i>  koordinataxel; rät <a href="/wiki/linje" title="linje">linje</a> utifrån vilken man definierar <a href="/wiki/koordinat" title="koordinat">koordinater</a><dl><dd></dd><dd class="semantic-relation template-sammansättningar"><em title="Ord som består av flera andra ord">Sammansättningar:</em> <a class="new" href="/w/index.php?title=koordinataxel&amp;action=edit&amp;redlink=1" title="koordinataxel (inte skapad ännu)">koordinataxel</a>, <a href="/wiki/x-axel" title="x-axel">x-axel</a>, <a href="/wiki/y-axel" title="y-axel">y-axel</a>, <a href="/wiki/z-axel" title="z-axel">z-axel</a></dd></dl></li><li><i>(politik, historia)</i>  Axeln Rom-Berlin-Tokyo; <a href="/wiki/allians" title="allians">alliansen</a> mellan <a class="new" href="/w/index.php?title=axelmakterna&amp;action=edit&amp;redlink=1" title="axelmakterna (inte skapad ännu)">axelmakterna</a> under <a href="/wiki/andra_v%C3%A4rldskriget" title="andra världskriget">andra världskriget</a>; utvidgat även andra föraktade allianser<dl><dd></dd><dd class="semantic-relation template-sammansättningar"><em title="Ord som består av flera andra ord">Sammansättningar:</em> <a class="new" href="/w/index.php?title=axelmakt&amp;action=edit&amp;redlink=1" title="axelmakt (inte skapad ännu)">axelmakt</a>, <a class="new" href="/w/index.php?title=axelmakterna&amp;action=edit&amp;redlink=1" title="axelmakterna (inte skapad ännu)">axelmakterna</a></dd><dd></dd><dd class="semantic-relation template-fraser"><em title="Begrepp som består av flera ord">Fraser:</em> <a class="new" href="/w/index.php?title=ondskans_axelmakter&amp;action=edit&amp;redlink=1" title="ondskans axelmakter (inte skapad ännu)">ondskans axelmakter</a></dd></dl></li><li><i>(sport, skridskoåkning)</i>  hopp inom <a href="/wiki/konst%C3%A5kning" title="konståkning">konståkning</a> på <a href="/wiki/skridsko" title="skridsko">skridsko</a> där konståkaren hoppar upp framåt, och därför roterar ett halvt varv längre än andra hopp, d.v.s. ett (eller flera) och ett halvt varv i luften<dl><dd><i>Han gjorde en perfekt trippel <b>axel</b>.</i></dd><dd></dd><dd class="semantic-relation template-sammansättningar"><em title="Ord som består av flera andra ord">Sammansättningar:</em> <a class="new" href="/w/index.php?title=axelhoppet&amp;action=edit&amp;redlink=1" title="axelhoppet (inte skapad ännu)">axelhoppet</a></dd><dd></dd><dd class="semantic-relation template-etymologi"><em title="Ordets ursprung">Etymologi:</em> Eponym efter den norske konståkaren <a class="extiw" href="https://sv.wikipedia.org/wiki/Axel_R._Paulsen" title="w:Axel R. Paulsen">Axel R. Paulsen</a> (1885-1939).</dd></dl></li></ol><dl><dd><noscript><img data-file-width="222" data-file-height="18" alt="Indragna rader ovanför strecket gäller en särskild definition. Eventuella rader närmast nedan kan gälla en eller flera av definitionerna ovan." src="//upload.wikimedia.org/wikipedia/commons/8/83/Hor_barileto_avgraensare_i_222_18_px_trans.png" decoding="async" title="Indragna rader ovanför strecket gäller en särskild definition. Eventuella rader närmast nedan kan gälla en eller flera av definitionerna ovan." width="222" height="18" /></noscript><span class="lazy-image-placeholder" data-alt="Indragna rader ovanför strecket gäller en särskild definition. Eventuella rader närmast nedan kan gälla en eller flera av definitionerna ovan." data-height="18" data-src="//upload.wikimedia.org/wikipedia/commons/8/83/Hor_barileto_avgraensare_i_222_18_px_trans.png" data-width="222" style="width: 222px;height: 18px;">&nbsp;</span></dd><dd></dd><dd class="semantic-relation template-besläktade_ord"><em title="Relaterade ord med samma ursprung (men som har andra prefix eller suffix, eller är av annan ordklass)">Besläktade ord:</em> <a href="/wiki/axial" title="axial">axial</a>, <a href="/wiki/axiell" title="axiell">axiell</a></dd></dl><h4 class="in-block"><span id=".C3.96vers.C3.A4ttningar"></span><span class="mw-headline" id="Översättningar">Översättningar</span><span class="mw-editsection"><a class="mw-ui-icon mw-ui-icon-element mw-ui-icon-wikimedia-edit-base20 edit-page mw-ui-icon-flush-right" data-section="3" href="/w/index.php?title=axel&amp;action=edit&amp;section=3" title="Redigera avsnitt Översättningar">Redigera</a></span></h4><div class="NavFrame översättningar"><div class="NavHead">(anatomi) kroppsdel</div><div class="NavContent"><div class="ö-content"><ul><li>bokmål: <span class="ö" data-lang="no" data-title="skulder"><a href="/wiki/skulder#Bokm%C3%A5l" title="skulder">skulder</a></span>, <span class="ö" data-gender="f" data-lang="no" data-title="aksel"><a href="/wiki/aksel#Bokm%C3%A5l" title="aksel">aksel</a></span><sup>&nbsp;<a class="extiw" href="https://no.wiktionary.org/wiki/aksel" title="no:aksel">(no)</a></sup> <b class="gender" title="femininum"><i>f</i></b></li><li>danska: <span class="ö" data-gender="u" data-lang="da" data-title="skulder"><a href="/wiki/skulder#Danska" title="skulder">skulder</a></span><sup>&nbsp;<a class="extiw" href="https://da.wiktionary.org/wiki/skulder" title="da:skulder">(da)</a></sup> <b class="gender" title="utrum"><i>u</i></b></li><li>engelska: <span class="ö" data-lang="en" data-title="shoulder"><a href="/wiki/shoulder#Engelska" title="shoulder">shoulder</a></span><sup>&nbsp;<a class="extiw" href="https://en.wiktionary.org/wiki/shoulder" title="en:shoulder">(en)</a></sup></li><li>finska: <span class="ö" data-lang="fi" data-title="olka"><a href="/wiki/olka#Finska" title="olka">olka</a></span><sup>&nbsp;<a class="extiw" href="https://fi.wiktionary.org/wiki/olka" title="fi:olka">(fi)</a></sup></li><li>franska: <span class="ö" data-gender="f" data-lang="fr" data-title="épaule"><a href="/wiki/%C3%A9paule#Franska" title="épaule">épaule</a></span><sup>&nbsp;<a class="extiw" href="https://fr.wiktionary.org/wiki/%C3%A9paule" title="fr:épaule">(fr)</a></sup> <b class="gender" title="femininum"><i>f</i></b></li><li>frisiska: <span class="ö" data-gender="n" data-lang="fy" data-title="skouder"><a href="/wiki/skouder#Frisiska" title="skouder">skouder</a></span><sup>&nbsp;<a class="extiw" href="https://fy.wiktionary.org/wiki/skouder" title="fy:skouder">(fy)</a></sup> <b class="gender" title="neutrum"><i>n</i></b></li><li>italienska: <span class="ö" data-gender="f" data-lang="it" data-title="spalla"><a href="/wiki/spalla#Italienska" title="spalla">spalla</a></span><sup>&nbsp;<a class="extiw" href="https://it.wiktionary.org/wiki/spalla" title="it:spalla">(it)</a></sup> <b class="gender" title="femininum"><i>f</i></b></li><li>japanska: <span class="ö" data-lang="ja" data-title="肩"><a href="/wiki/%E8%82%A9#Japanska" title="肩">肩</a></span><sup>&nbsp;<a class="extiw" href="https://ja.wiktionary.org/wiki/%E8%82%A9" title="ja:肩">(ja)</a></sup> (kata)</li><li>katalanska: <span class="ö" data-lang="ca" data-title="espatlla"><a class="new" hr